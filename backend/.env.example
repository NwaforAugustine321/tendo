# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Memory (legacy — mem0 is deactivated but config retained)
MEM0_API_KEY=your-mem0-api-key

# Memory System
MAX_MESSAGE_TOKEN_SIZE=1024

# Redis (used for business context caching only)
REDIS_URL=redis://localhost:6379

# LLM Provider: "anthropic", "gemini", "ollama", "huggingface", "grok", or "groq"
LLM_PROVIDER=anthropic
# Set to false for local models (lmstudio, ollama, msty) that use text-based ReAct instead of native function calling
NATIVE_TOOL_CALLING=true
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local models)
OLLAMA_MODEL=nemotron-3-super
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace Inference
HF_TOKEN=your-hf-token
HF_MODEL=meta-llama/Llama-3.1-8B
HF_PROVIDER=featherless-ai

# Grok (xAI)
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-3-mini

# Groq (fast inference)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Provider: "gemini" or "openai"
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-openai-api-key

# Voice (Gemini Live API)
GOOGLE_VOICE_API_KEY=your-google-genai-api-key
GOOGLE_VOICE_MODEL=gemini-2.0-flash-live-001

# Dev
SPEC_HOT_RELOAD=true

# Intelligence Agent
INTELLIGENCE_LLM_PROVIDER=msty
INTELLIGENCE_LLM_MODEL=llama3.2:3b
INTELLIGENCE_MAX_ITERATIONS=5
INTELLIGENCE_EMBEDDING_BATCH_SIZE=10

# Graph Database
GRAPH_DB_URI=bolt://localhost:7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=
GRAPH_DB_NAME=neo4j

# Business Event System Worker
EVENT_MIN_EVENT_COUNT=5
EVENT_MIN_CHAR_COUNT=500
EVENT_MAX_EVENTS_PER_BATCH=50
EVENT_POLLING_INTERVAL_SECONDS=30
EVENT_MAX_BATCH_SIZE=100

# Business Event Scheduler
EVENT_MAX_CONCURRENT_WORKERS=10
EVENT_DISPATCHER_INTERVAL=15
EVENT_IDLE_EVICTION_CYCLES=3

# Msty (local OpenAI-compatible)
MSTY_MODEL=codellama-7b
MSTY_BASE_URL=http://localhost:10000/v1

# LMStudio (local OpenAI-compatible)
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Vector Store (semantic memory)
VECTOR_STORE_PATH=./data/vector_store
