# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# LLM Provider: "anthropic", "gemini", "ollama", "msty", "lmstudio" or "nvidia"
LLM_PROVIDER=nvidia
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434

MSTY_MODEL=llama3.2:3b
MSTY_BASE_URL=http://localhost:11964/v1
MSTY_NUM_CTX=4096

LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# NVIDIA AI Endpoints
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Storage
BUCKET_NAME=tendo
VECTOR_STORE_PATH=./data/vector_store

# Voice (Google Gemini Live API key)
GOOGLE_VOICE_API_KEY=your-google-genai-api-key

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Dev
SPEC_HOT_RELOAD=true

# Agent
AGENT_NAME=Jay



# Business Event System Worker
EVENT_MIN_EVENT_COUNT=5
EVENT_MIN_CHAR_COUNT=500
EVENT_MAX_EVENTS_PER_BATCH=50
EVENT_POLLING_INTERVAL_SECONDS=30
EVENT_MAX_BATCH_SIZE=100

# Business Event Scheduler
EVENT_MAX_CONCURRENT_WORKERS=10
EVENT_DISPATCHER_INTERVAL=15
EVENT_IDLE_EVICTION_CYCLES=3

# WhatsApp
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_API_VERSION=v26.0
WHATSAPP_APP_ID=your-app-id
WHATSAPP_TEST_TOKEN=your-test-token

# Record Knowledge Engine
RECORD_KNOWLEDGE_MAX_ENTRIES=20
RECORD_KNOWLEDGE_MAX_FOLDER_ENTRIES=200
RECORD_KNOWLEDGE_MAX_SUMMARY_LENGTH=2000
RECORD_KNOWLEDGE_TOKEN_LIMIT=8000
RECORD_KNOWLEDGE_MAX_RETRIES=3
RECORD_KNOWLEDGE_LLM_TIMEOUT=30
